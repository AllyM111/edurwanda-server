# ---- Required ----
DATABASE_URL=postgresql://user:password@host:5432/dbname
DIRECT_URL=postgresql://user:password@host:5432/dbname
# Long random value, e.g.  openssl rand -hex 48
JWT_SECRET=

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Strongly recommended ----
# This account can never be demoted, blocked or deleted by other admins.
MAIN_ADMIN_EMAIL=admin@example.com
NODE_ENV=production

# ---- Optional ----
PORT=5000
JWT_EXPIRES_IN=7d
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=https://edurwanda-lake.vercel.app,http://localhost:5173
# Allow https://edurwanda-*.vercel.app preview deployments (default: true)
ALLOW_VERCEL_PREVIEWS=true
# Max upload size in MB (default 10 = Cloudinary free plan limit)
UPLOAD_MAX_MB=10
# Public address of the website (used in /sitemap.xml)
SITE_URL=https://edurwanda-lake.vercel.app
# Hosts PDFs may be downloaded from (default: res.cloudinary.com)
DOWNLOAD_ALLOWED_HOSTS=res.cloudinary.com

# ---- Only for the one-off scripts (never put these in the app's env) ----
# PROD_DATABASE_URL=
# ADMIN_EMAIL=
# ADMIN_NEW_PASSWORD=
